{
  "model": "DistMult-AU",
  "dataset": "WN18RR",
  "model_loss_path": "models/losses/au_loss.py",
  "model_strategy_path": "models/strategies/kgau_strategy.py",
  "add_reciprocal_relations": true,
  "head_eval_mode": "sp_inverse",
  "dim": 512,
  "batch_size": 1024,
  "epochs": 400,
  "optim": "adagrad",
  "lr": 0.3312683797847912,
  "entity_dropout": 0.3667933782666931,
  "relation_dropout": 0.5,
  "entity_regularize_weight": 2.504743872791287e-12,
  "relation_regularize_weight": 3.0597172820406116e-14,
  "entity_regularize_weighted": true,
  "relation_regularize_weighted": true,
  "regularize_p": 3,
  "init_method": "uniform_",
  "init_uniform_a": -0.7226369686094678,
  "epoch_per_eval": 5,
  "lr_scheduler": "ReduceLROnPlateau",
  "lr_scheduler_mode": "max",
  "lr_scheduler_factor": 0.95,
  "lr_scheduler_patience": 7,
  "lr_scheduler_threshold": 0.0001,
  "gamma_q": 1,
  "gamma_t": 1,
  "tuni": 0.25,
  "normalize_au_vectors": true,
  "eval_batch_size": 256,
  "early_stopping_patience": 10,
  "early_stopping_min_epochs": 50,
  "early_stopping_min_metric": 0.05,
  "output_dir_prefix": "logs/DistMult-AU_WN18RR",
  "tie_rtol": 0.0001,
  "gamma_h": 0,
  "tie_handling": "rounded_mean_rank",
  "weight_decay": 0.0,
  "gamma_ent": 0,
  "tie_atol": 1e-05,
  "normalize_lp_scores": false
}
