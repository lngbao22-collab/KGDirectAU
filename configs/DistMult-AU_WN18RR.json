{
  "model": "DistMult-AU",
  "dataset": "WN18RR",
  "model_loss_path": "models/losses/adversarial_bce_loss.py",
  "model_strategy_path": "models/strategies/negsamp_strategy.py",
  "model_sampler_path": "models/samplers/filtered_1_to_n_sampler.py",
  "head_eval_mode": "sp_inverse",

  "normalize_au_vectors": true,
  "gamma_q": 0.5,
  "gamma_t": 0.5,
  "gamma_cross": 0,
  "tuni": 4,
  "report_au": true,

  "dim": 64,

  "add_reciprocal_relations": true,
  "batch_size": 512,
  "epochs": 400,
  "optim": "adam",
  "lr": 0.002,
  "weight_decay": 0.0,
  "warm_up_steps": 40000,
  "lr_decay_factor": 0.1,
  "shuffle_train": true,

  "regularization": 5e-06,

  "training_cadence": "epoch",
  "epoch_per_eval": 5,

  "test_batch_size": 8,

  "early_stopping_patience": 10,
  "early_stopping_min_epochs": 50,
  "early_stopping_min_metric": 0.05,

  "output_dir_prefix": "logs/DistMult-AU_WN18RR",
  "tie_handling": "rounded_mean_rank",
  "tie_rtol": 0.0001,
  "tie_atol": 1e-05,
  "normalize_lp_scores": false
}
