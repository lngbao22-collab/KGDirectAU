{
  "model": "ComplEx-AU",
  "dataset": "WN18RR",

  "model_loss_path": "models/losses/au_loss.py",
  "model_strategy_path": "models/strategies/kgau_strategy.py",
  "model_sampler_path": "",
  "model_embedder_path": "models/embedders/lookup_embedder.py",
  "model_scorer_path": "models/scorers/complex_scorer.py",

  "normalize_au_vectors": true,
  "gamma_q": 0.1,
  "gamma_t": 0.1,
  "gamma_ent": 0.0,
  "gamma_cross": 0.0,
  "gamma_h": 0.0,
  "au_deduplicate": true,
  "tuni": 2,

  "learnable_au_gammas": true,
  "learnable_uniformity_scale": true,
  "log_au_gamma_lr": 0.5,
  "log_uniformity_lr": 0.001,
  "gamma_linear_schedule": true,
  "gamma_schedule_end": 1,
  "gamma_schedule_start_epoch": 0,
  "gamma_schedule_epochs": 0,

  "dim": 128,

  "add_reciprocal_relations": true,

  "entity_dropout": 0.0,
  "relation_dropout": 0.0,
  "regularize_p": 3,
  "entity_regularize_weight": 0.0,
  "relation_regularize_weight": 0.0,
  "entity_regularize_weighted": false,
  "relation_regularize_weighted": false,
  "init_method": "uniform_",
  "init_uniform_a": -0.2815,

  "batch_size": 512,
  "epochs": 400,
  "optim": "adagrad",
  "lr": 0.15,
  "weight_decay": 0.0,
  "lr_scheduler": "ReduceLROnPlateau",
  "lr_scheduler_mode": "max",
  "lr_scheduler_factor": 0.95,
  "lr_scheduler_patience": 3,
  "lr_scheduler_threshold": 0.0001,

  "epoch_per_eval": 5,
  "eval_batch_size": 256,

  "early_stopping_patience": 80,
  "early_stopping_min_epochs": 50,
  "early_stopping_min_metric": 0.05,

  "max_to_keep": 0,
  "output_dir_prefix": "logs/ComplEx-AU_WN18RR_libkge_best_config",

  "train_path": "data/WN18RR/preprocessed/train.txt.json",
  "valid_path": "data/WN18RR/preprocessed/valid.txt.json",
  "test_path": "data/WN18RR/preprocessed/test.txt.json",
  "valid_w_label_path": "data/WN18RR/preprocessed/valid_w_label.txt.json",
  "test_w_label_path": "data/WN18RR/preprocessed/test_w_label.txt.json",

  "tie_handling": "rounded_mean_rank",
  "tie_rtol": 0.0001,
  "tie_atol": 1e-05,

  "normalize_lp_scores": false,

  "task": "both",
  "report_au": true
}
