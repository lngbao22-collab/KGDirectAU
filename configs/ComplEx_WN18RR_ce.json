{
  "model": "ComplEx",
  "dataset": "WN18RR",
  "model_loss_path": "models/losses/ce_loss.py",
  "model_strategy_path": "models/strategies/1vsall_strategy.py",
  "kbc_reciprocal_relations": true,
  "head_eval_mode": "sp_inverse",
  "dim": 100,
  "batch_size": 100,
  "epochs": 400,
  "optim": "adagrad",
  "lr": 0.1,
  "regularizer": "n3_kbc",
  "regularize_weight": 0.1,
  "init_method": "kbc",
  "init_scale": 0.001,
  "sparse_embeddings": true,
  "epoch_per_eval": 5,
  "eval_batch_size": 256,
  "output_dir_prefix": "logs/ComplEx_WN18RR_ce",
  "tie_rtol": 0.0001,
  "tie_handling": "rounded_mean_rank",
  "weight_decay": 0.0,
  "bidirectional_1vsall": false,
  "tie_atol": 1e-05,
  "normalize_lp_scores": false
}
