{
  "model": "pRotatE",
  "dataset": "WN18RR",
  "model_loss_path": "models/losses/adversarial_bce_loss.py",
  "model_strategy_path": "models/strategies/negsamp_strategy.py",
  "model_sampler_path": "models/samplers/filtered_1_to_n_sampler.py",
  "head_eval_mode": "po_forward",
  "dim": 500,
  "batch_size": 512,
  "epochs": 1000,
  "optim": "adam",
  "lr": 5e-05,
  "adversarial_training": true,
  "adversarial_temperature": 0.5,
  "margin": 6.0,
  "n_sample": 1024,
  "training_cadence": "step",
  "max_steps": 80000,
  "valid_steps": 10000,
  "save_checkpoint_steps": 10000,
  "epoch_per_eval": 5,
  "warm_up_steps": 40000,
  "lr_decay_factor": 0.1,
  "shuffle_train": true,
  "test_batch_size": 8,
  "normalize_phases": true,
  "score_query_chunk_size": 256,
  "eval_candidate_chunk_size": 2048,
  "eval_entity_chunk_size": 4096,
  "use_amp": true,
  "output_dir_prefix": "logs/pRotatE_WN18RR_adversarial_bce"
}
