{

  "model": "DaBR",
  "dataset": "FB15k237",

  "model_loss_path": "models/losses/pointwise_logistic_loss.py",
  "model_strategy_path": "models/strategies/negsamp_strategy.py",
  "model_sampler_path": "models/samplers/uniform_pointwise_sampler.py",

  "head_eval_mode": "sp_inverse",
  "add_reciprocal_relations": true,
  "dim": 500,
  "lmbda": 0.5,
  "lmbda_two": 0.01,
  "dabr_reg_include_negatives": true,

  "n_batches": 100,
  "epochs": 10000,
  "optim": "adagrad",
  "lr": 0.05,
  "weight_decay": 0,

  "n_sample": 10,
  "seed": 123,
  "eval_every_epoch": 200,
  "eval_batch_size": 64,
  "eval_entity_chunk_size": 256,
  "valid_metric": "mrr",
  "early_stopping_patience": 10,
  "early_stopping_min_epochs": 800,

  "max_to_keep": 0,
  "output_dir_prefix": "logs/DaBR_FB15k237",
  "report_au": false
}
