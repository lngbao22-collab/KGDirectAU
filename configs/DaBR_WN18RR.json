  "n_batches": 100,

  "epochs": 6000,

  "optim": "adagrad",

  "lr": 0.1,

  "weight_decay": 0,



  "n_sample": 5,

  "seed": 123,



  "epoch_per_eval": 200,

  "eval_batch_size": 64,

  "eval_entity_chunk_size": 256,

  "valid_metric": "mrr",

  "early_stopping_patience": 10,

  "early_stopping_min_epochs": 800,



  "max_to_keep": 0,

  "output_dir_prefix": "logs/DaBR_WN18RR",



  "report_au": false

}

