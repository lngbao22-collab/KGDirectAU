{
  "model": "DaBR",
  "dataset": "WN18RR",

  "model_loss_path": "models/losses/pointwise_logistic_loss.py",
  "model_strategy_path": "models/strategies/negsamp_strategy.py",
  "model_sampler_path": "models/samplers/uniform_pointwise_sampler.py",

  "head_eval_mode": "po_forward",

  "dim": 500,

  "lmbda": 0.5,
  "lmbda_two": 0.01,

  "n_batches": 100,
  "epochs": 10000,
  "optim": "adagrad",
  "lr": 0.1,
  "weight_decay": 0,

  "n_sample": 5,
  "seed": 123,

  "epoch_per_eval": 400,
  "valid_metric": "hit@10",
  "early_stopping_patience": 10,
  "early_stopping_min_epochs": 400,

  "max_to_keep": 0,
  "output_dir_prefix": "logs/DaBR_WN18RR",

  "report_au": true
}
