{
  "model": "ComplEx-AU",
  "dataset": "FB15k237",

  "model_loss_path": "models/losses/au_loss.py",
  "model_strategy_path": "models/strategies/kgau_strategy.py",

  "head_eval_mode": "sp_inverse",

  "normalize_au_vectors": true,
  "gamma_q": 1,
  "gamma_t": 1,
  "gamma_ent": 0,
  "gamma_cross": 0.0,
  "gamma_h": 0,
  "au_deduplicate": true,
  "tuni": 2,

  "dim": 1000,

  "kbc_reciprocal_relations": true,

  "regularizer": "n3_kbc",
  "regularize_weight": 0.05,
  "init_method": "kbc",
  "init_scale": 0.001,
  "sparse_embeddings": true,

  "batch_size": 1024,
  "epochs": 400,
  "optim": "adam",
  "lr": 0.001,
  "weight_decay": 0.0,
  "shuffle_train": true,
  "use_amp": true,

  "training_cadence": "epoch",
  "epoch_per_eval": 5,
  "eval_batch_size": 256,
  "test_batch_size": 16,

  "early_stopping_patience": 10,
  "early_stopping_min_epochs": 50,
  "early_stopping_min_metric": 0.05,

  "max_to_keep": 0,
  "output_dir_prefix": "logs/ComplEx-AU_v2_FB15k237",

  "tie_handling": "rounded_mean_rank",
  "tie_rtol": 0.0001,
  "tie_atol": 1e-05,

  "normalize_lp_scores": false
}
