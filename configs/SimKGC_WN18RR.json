{

  "model": "SimKGC",
  "dataset": "WN18RR",

  "model_loss_path": "models/losses/infonce_loss.py",
  "model_strategy_path": "models/strategies/inbatch_strategy.py",
  "model_sampler_path": "models/samplers/masking_sampler.py",

  "dim": 768,
  "dropout": 0.1,
  "bert_encoder": "distilbert-base-uncased",
  "pooling": "mean",
  "additive_margin": 0.02,
  "finetune_t": true,
  "infonce_t": 0.05,
  "use_self_negative": true,
  "pre_batch": 0,
  "pre_batch_weight": 0.0,
  "grad_clip": 10.0,
  "max_num_tokens": 50,
  "use_link_graph": true,
  "neighbor_weight": 0.05,
  "rerank_n_hop": 0,

  "batch_size": 512,
  "shared_encoder": false,
  "epochs": 50,
  "lr": 5e-05,
  "weight_decay": 0.0001,
  "lr_scheduler": "linear",
  "use_amp": true,

  "eval_batch_size": 128,
  "chunk_size": 8192,
  "warmup": 400,
  "workers": 2,
  "print_freq": 20,

  "max_to_keep": 3,
  "output_dir_prefix": "logs/SimKGC_WN18RR",
  "epoch_per_eval": 1,
  "early_stopping_patience": 5,
  "early_stopping_min_epochs": 10,
  "early_stopping_min_metric": 0.05,
  "report_au": true,
  "tuni": 4,
  "gamma_q": 1.0,
  "gamma_t": 1.0,
  "gamma_ent": 1.0,
  "gamma_cross": 1.0
}


