{
  "model": "pRotatE-AU",
  "dataset": "WN18RR",

  "model_loss_path": "models/losses/au_loss.py",
  "model_strategy_path": "models/strategies/kgau_strategy.py",
  "model_sampler_path": "",

  "head_eval_mode": "sp_inverse",

  "normalize_au_vectors": true,
  "gamma_q": 0.5,
  "gamma_t": 0.5,
  "gamma_cross": 0,
  "tuni": 4,

  "dim": 64,

  "add_reciprocal_relations": true,

  "batch_size": 512,
  "epochs": 400,
  "optim": "adam",
  "lr": 5e-05,
  "weight_decay": 0.0,
  "shuffle_train": true,
  "use_amp": true,

  "n_sample": 0,

  "training_cadence": "epoch",
  "epoch_per_eval": 5,
  "test_batch_size": 8,
  "score_query_chunk_size": 256,
  "eval_candidate_chunk_size": 2048,
  "eval_entity_chunk_size": 4096,
  "normalize_phases": true,

  "early_stopping_patience": 10,
  "early_stopping_min_epochs": 50,
  "early_stopping_min_metric": 0.05,

  "max_to_keep": 0,
  "output_dir_prefix": "logs/pRotatE-AU_WN18RR",

  "tie_handling": "rounded_mean_rank",
  "tie_rtol": 0.0001,
  "tie_atol": 1e-05,

  "normalize_lp_scores": false,
  "report_au": true
}
