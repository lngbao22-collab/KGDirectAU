  "lr": 0.002,
  "optim": "adam",
  "weight_decay": 0.0,
  "regularization": 0.000005,
  "max_steps": 80000,
  "valid_steps": 10000,
  "save_checkpoint_steps": 10000,
  "warm_up_steps": 40000,
  "lr_decay_factor": 0.1,
  "epochs": 1000,
  "shuffle_train": true,
  "test_batch_size": 8,
  "neg_score_chunk_size": 0,
  "normalize_lp_scores": false,
  "tie_handling": "rounded_mean_rank",
  "tie_rtol": 0.0001,
  "tie_atol": 0.00001,
  "use_amp": true
}
