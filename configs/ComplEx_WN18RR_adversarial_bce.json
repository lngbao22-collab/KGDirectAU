{
  "model": "ComplEx",
  "model_embedder_path": "models/embedders/lookup_embedder.py",
  "model_scorer_path": "models/scorers/complex_scorer.py",
  "model_loss_path": "models/losses/adversarial_bce_loss.py",
  "model_sampler_path": "models/samplers/filtered_1_to_n_sampler.py",
  "model_strategy_path": "models/strategies/negsamp_strategy.py",
  "dataset": "WN18RR",
  "task": "both",
  "train_path": "data/WN18RR/preprocessed/train.txt.json",
  "valid_path": "data/WN18RR/preprocessed/valid.txt.json",
  "test_path": "data/WN18RR/preprocessed/test.txt.json",
  "valid_w_label_path": "data/WN18RR/preprocessed/valid_w_label.txt.json",
  "test_w_label_path": "data/WN18RR/preprocessed/test_w_label.txt.json",
  "output_dir_prefix": "logs/ComplEx_WN18RR_adversarial_bce",
  "add_reciprocal_relations": false,
  "adversarial_training": true,
