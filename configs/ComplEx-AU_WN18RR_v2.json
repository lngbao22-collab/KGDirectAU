{
  "model": "ComplEx-AU",
  "dataset": "WN18RR",

  "model_loss_path": "models/losses/au_loss.py",
  "model_strategy_path": "models/strategies/kgau_strategy.py",

  "head_eval_mode": "sp_inverse",

  "normalize_au_vectors": true,
  "gamma_q": 1,
  "gamma_t": 1,
  "gamma_ent": 0,
  "gamma_cross": 0.0,
  "gamma_h": 0,
  "au_deduplicate": true,
  "tuni": 2,

  "learnable_au_gammas": true,
  "log_au_gamma_lr": 0.1,
  "gamma_linear_schedule": true,
  "gamma_schedule_end": 0.1,
  "gamma_schedule_start_epoch": 0,
  "gamma_schedule_epochs": 0,

  "dim": 100,

  "kbc_reciprocal_relations": true,

  "regularizer": "n3_kbc",
  "regularize_weight": 0.1,
  "init_method": "kbc",
  "init_scale": 0.001,
  "sparse_embeddings": true,

  "batch_size": 512,
  "epochs": 100,
  "optim": "adagrad",
  "lr": 0.1,
  "weight_decay": 0.0,

  "epoch_per_eval": 5,
  "eval_batch_size": 256,

  "max_to_keep": 0,
  "output_dir_prefix": "logs/ComplEx-AU_v2_WN18RR",

  "tie_handling": "rounded_mean_rank",
  "tie_rtol": 0.0001,
  "tie_atol": 1e-05
}
