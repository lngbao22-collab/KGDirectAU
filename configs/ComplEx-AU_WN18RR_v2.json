{
  "model": "ComplEx-AU",
  "dataset": "WN18RR",
  "model_loss_path": "models/losses/au_loss.py",
  "model_strategy_path": "models/strategies/kgau_strategy.py",
  "kbc_reciprocal_relations": true,
  "head_eval_mode": "sp_inverse",
  "dim": 100,
  "batch_size": 100,
  "epochs": 100,
  "optim": "adagrad",
  "lr": 0.1,
  "regularizer": "n3_kbc",
  "regularize_weight": 0.1,
  "init_method": "kbc",
  "init_scale": 0.001,
  "sparse_embeddings": true,
  "epoch_per_eval": 5,
  "gamma_q": 0.5,
  "gamma_t": 0.5,
  "gamma_cross": 0.0,
  "tuni": 2,
  "normalize_au_vectors": true,
  "au_deduplicate": true,
  "weight_decay": 0.0,
  "gamma_ent": 0,
  "gamma_h": 0,
  "tie_handling": "rounded_mean_rank",
  "tie_atol": 1e-05,
  "tie_rtol": 0.0001,
  "eval_batch_size": 256,
  "max_to_keep": 0,
  "output_dir_prefix": "logs/ComplEx-AU_v2_WN18RR"
}
