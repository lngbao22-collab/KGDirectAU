{
  "model": "RotatE-AU",
  "dataset": "WN18RR",

  "model_loss_path": "models/losses/au_loss.py",
  "model_strategy_path": "models/strategies/kgau_strategy.py",
  "model_sampler_path": "",

  "head_eval_mode": "po_forward",

  "kgau_bidirectional": true,
  "uniformity_full_pdist": true,
  "max_uniformity_samples": 0,
  "normalize_au_vectors": true,
  "gamma_q": 1.0,
  "gamma_t": 1.0,
  "gamma_ent": 1.0,
  "average_uniformity_terms": true,
  "entity_uniformity_batch": true,
  "au_deduplicate": false,
  "gamma_cross": 0,
  "tuni": 4,

  "dim": 64,

  "adversarial_training": true,
  "margin": 6,
  "add_reciprocal_relations": false,

  "batch_size": 512,
  "epochs": 400,
  "optim": "adam",
  "lr": 1e-04,
  "weight_decay": 0.0,
  "test_eval_last": true,
  "test_eval_best": true,
  "shuffle_train": true,
  "use_amp": false,

  "n_sample": 0,

  "training_cadence": "epoch",
  "epoch_per_eval": 5,
  "test_batch_size": 8,
  "score_query_chunk_size": 256,
  "eval_candidate_chunk_size": 2048,
  "eval_entity_chunk_size": 4096,

  "early_stopping_patience": 10,
  "early_stopping_min_epochs": 50,
  "early_stopping_min_metric": 0.05,

  "max_to_keep": 0,
  "output_dir_prefix": "logs/RotatE-AU_WN18RR",

  "tie_handling": "rounded_mean_rank",
  "tie_rtol": 0.0001,
  "tie_atol": 1e-05,

  "normalize_lp_scores": true,
  "lp_distance_degree": 2
}
