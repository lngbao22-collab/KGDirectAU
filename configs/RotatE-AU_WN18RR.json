{
  "model": "RotatE-AU",
  "dataset": "WN18RR",
  "model_loss_path": "models/losses/au_loss.py",
  "model_strategy_path": "models/strategies/kgau_strategy.py",
  "add_reciprocal_relations": true,
  "head_eval_mode": "sp_inverse",
  "dim": 128,
  "batch_size": 128,
  "epochs": 400,
  "optim": "adagrad",
  "lr": 0.20986162552270587,
  "entity_regularize_weight": 1.0054555427885155e-06,
  "relation_regularize_weight": 1.5712131774007265e-17,
  "entity_regularize_weighted": true,
  "relation_regularize_weighted": true,
  "regularize_p": 3,
  "init_method": "xavier_normal_",
  "init_xavier_gain": 1.0,
  "epoch_per_eval": 5,
  "lr_scheduler": "ReduceLROnPlateau",
  "lr_scheduler_mode": "max",
  "lr_scheduler_factor": 0.95,
  "lr_scheduler_patience": 6,
  "lr_scheduler_threshold": 0.0001,
  "gamma_q": 1.0,
  "gamma_t": 1.0,
  "gamma_h": 0.5,
  "tuni": 2.0,
  "normalize_au_vectors": true,
  "eval_batch_size": 64,
  "early_stopping_patience": 10,
  "early_stopping_min_epochs": 50,
  "early_stopping_min_metric": 0.05,
  "l_norm": 2.0,
  "normalize_phases": true,
  "eval_entity_chunk_size": 256,
  "output_dir_prefix": "logs/RotatE-AU_WN18RR"
}
