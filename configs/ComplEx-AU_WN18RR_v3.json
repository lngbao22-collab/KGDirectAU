{

  "model": "ComplEx",
  "dataset": "WN18RR",
  "model_loss_path": "models/losses/au_loss.py",
  "model_strategy_path": "models/strategies/kgau_strategy.py",
  "model_sampler_path": "",
  "head_eval_mode": "sp_inverse",

  "normalize_au_vectors": true,

  "gamma_q": 1,
  "gamma_t": 1,
  "gamma_cross": 0,
  "tuni": 2,
  "tuni_as_alpha": true,
  "learnable_uniformity_scale": true,
  "log_uniformity_lr": 0.00005,
  "uniformity_tuni": 2.0,

  "dim": 500,

  "add_reciprocal_relations": true,
  "batch_size": 512,
  "epochs": 400,
  "optim": "adam",
  "lr": 0.002,
  "weight_decay": 0.0,

  "shuffle_train": true,

  "use_amp": true,

  "n_sample": 0,
  "regularization": 5e-06,

  "training_cadence": "epoch",
  "epoch_per_eval": 5,
  "test_batch_size": 8,

  "early_stopping_patience": 10,
  "early_stopping_min_epochs": 50,
  "early_stopping_min_metric": 0.05,

  "output_dir_prefix": "logs/ComplEx_WN18RR_adversarial_bce",
  "tie_handling": "rounded_mean_rank",
  "tie_rtol": 0.0001,
  "tie_atol": 1e-05,

  "normalize_lp_scores": false
}

