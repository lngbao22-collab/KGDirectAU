{
  "model": "ComplEx-AU",
  "dataset": "WN18RR",

  "model_loss_path": "models/losses/au_loss.py",
  "model_strategy_path": "models/strategies/kgau_strategy.py",
  "model_sampler_path": "",

  "head_eval_mode": "po_forward",

  "kgau_bidirectional": true,
  "uniformity_full_pdist": true,
  "max_uniformity_samples": 0,
  "normalize_au_vectors": true,
  "gamma_q": 1.0,
  "gamma_t": 1.0,
  "gamma_ent": 1.0,
  "gamma_cross": 0.0,
  "average_uniformity_terms": true,
  "entity_uniformity_batch": true,
  "au_deduplicate": false,
  "tuni": 4,

  "learnable_au_gammas": true,
  "log_au_gamma_lr": 0.5,
  "gamma_linear_schedule": true,
  "gamma_schedule_end": 0.1,
  "gamma_schedule_start_epoch": 0,
  "gamma_schedule_epochs": 50,

  "dim": 128,

  "adversarial_training": true,
  "margin": 200,
  "add_reciprocal_relations": true,

  "batch_size": 512,
  "epochs": 400,
  "optim": "adam",
  "lr": 0.002,
  "test_eval_last": true,
  "test_eval_best": true,
  "shuffle_train": true,

  "n_sample": 0,
  "regularization": 5e-06,

  "training_cadence": "epoch",
  "epoch_per_eval": 5,
  "test_batch_size": 8,

  "early_stopping_patience": 10,
  "early_stopping_min_epochs": 50,
  "early_stopping_min_metric": 0.05,

  "max_to_keep": 0,

  "tie_handling": "rounded_mean_rank",
  "tie_rtol": 0.0001,
  "tie_atol": 1e-05,

  "normalize_lp_scores": false,
  "report_au": true
}
