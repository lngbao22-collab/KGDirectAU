  "test_path": "data/FB15k237/preprocessed/test.txt.json",
  "valid_w_label_path": "data/FB15k237/preprocessed/valid_w_label.txt.json",
  "test_w_label_path": "data/FB15k237/preprocessed/test_w_label.txt.json",
  "output_dir_prefix": "logs/ComplEx_FB15k237_ce",
