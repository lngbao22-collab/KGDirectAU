{
  "model": "ComplEx",
  "dataset": "FB15k237",

  "model_loss_path": "models/losses/ce_loss.py",
  "model_strategy_path": "models/strategies/1vsall_strategy.py",

  "head_eval_mode": "sp_inverse",

  "dim": 2000,

  "kbc_reciprocal_relations": true,
  "bidirectional_1vsall": false,

  "regularizer": "n3_kbc",
  "regularize_weight": 0.05,
  "init_method": "kbc",
  "init_scale": 0.001,
  "sparse_embeddings": true,

  "batch_size": 100,
  "epochs": 400,
  "optim": "adagrad",
  "lr": 0.1,
  "weight_decay": 0.0,

  "epoch_per_eval": 3,
  "eval_batch_size": 256,

  "max_to_keep": 0,
  "output_dir_prefix": "logs/ComplEx_FB15k237_ce",

  "tie_handling": "rounded_mean_rank",
  "tie_rtol": 0.0001,
  "tie_atol": 1e-05,

  "normalize_lp_scores": false,
  "report_au": true
}
