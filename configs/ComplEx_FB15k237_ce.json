{
  "model": "ComplEx",
  "model_embedder_path": "models/embedders/lookup_embedder.py",
  "model_scorer_path": "models/scorers/complex_scorer.py",
  "model_loss_path": "models/losses/ce_loss.py",
  "model_sampler_path": "",
  "model_strategy_path": "models/strategies/1vsall_strategy.py",
  "dataset": "FB15k237",
  "task": "both",
  "train_path": "data/FB15k237/preprocessed/train.txt.json",
