{
  "model": "RotatE",
  "dataset": "WN18RR",
  "model_loss_path": "models/losses/adversarial_bce_loss.py",
  "model_strategy_path": "models/strategies/negsamp_strategy.py",
  "model_sampler_path": "models/samplers/filtered_1_to_n_sampler.py",
  "head_eval_mode": "po_forward",

  "dim": 500,

  "batch_size": 512,
  "epochs": 1000,
  "optim": "adam",
  "lr": 5e-05,
  "weight_decay": 0.0,
  "shuffle_train": true,
  "use_amp": true,

  "adversarial_training": true,
  "adversarial_temperature": 0.5,
  "margin": 6.0,
  "n_sample": 1024,
  "neg_score_chunk_size": 128,
  "neg_weight_chunk_size": 256,

  "training_cadence": "step",
  "max_steps": 80000,
  "valid_steps": 10000,
  "save_checkpoint_steps": 10000,
  "epoch_per_eval": 5,
  "warm_up_steps": 40000,
  "lr_decay_factor": 0.1,

  "test_batch_size": 8,
  "score_query_chunk_size": 256,
  "eval_candidate_chunk_size": 2048,
  "eval_entity_chunk_size": 4096,

  "output_dir_prefix": "logs/RotatE_WN18RR_adversarial_bce",
  "tie_handling": "rounded_mean_rank",
  "tie_rtol": 0.0001,
  "tie_atol": 1e-05,
  "normalize_lp_scores": false
}
